{
  "name": "cloudfact",
  "version": "0.8.3",
  "description": "Publish an HTML file or a folder from this machine to a public Cloudflare URL with /cloudfact (quick tunnel without an account, or Workers with a fixed URL).",
  "author": {
    "name": "Gabriel Chaves",
    "url": "https://github.com/gabrielchaves6"
  },
  "homepage": "https://github.com/gabrielchaves6/cloudfact",
  "repository": "https://github.com/gabrielchaves6/cloudfact",
  "license": "MIT",
  "keywords": ["cloudflare", "deploy", "static", "tunnel", "mcp"],
  "mcpServers": {
    "cloudfact": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/dist/server.js"]
    }
  }
}
