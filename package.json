{
  "name": "cloudfact",
  "version": "0.7.1",
  "description": "Publish a folder or HTML file from your machine to a public Cloudflare URL with one command. CLI + MCP server + /cloudfact skill.",
  "type": "module",
  "bin": {
    "cloudfact": "dist/bin.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "eslint --fix . && prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run docs && npm run verify",
    "start": "node dist/server.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/server.js",
    "prepack": "npm run build",
    "docs": "node scripts/generate-docs.js",
    "verify": "node scripts/verify-versions.js",
    "bump": "node scripts/bump-version.js"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "files": [
    "dist",
    "skills",
    ".claude-plugin",
    "server.json",
    "install.sh",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "mcpName": "io.github.gabrielchaves6/cloudfact",
  "repository": {
    "type": "git",
    "url": "https://github.com/gabrielchaves6/cloudfact"
  },
  "homepage": "https://github.com/gabrielchaves6/cloudfact",
  "keywords": [
    "mcp",
    "mcp-server",
    "cloudflare",
    "deploy",
    "static-site",
    "tunnel",
    "cloudflared",
    "workers",
    "claude-code",
    "codex"
  ],
  "author": "Gabriel Chaves"
}
